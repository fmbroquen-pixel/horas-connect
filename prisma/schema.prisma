// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  admin
  guest
  reader
}

enum Modalidad {
  presencial
  virtual
  valor_cero
}

// "Ownership" en la UI. Los valores viejos (titular/acompanante) quedan
// mapeados en la base para no migrar datos: el codigo usa owner/backup.
enum Ownership {
  owner      @map("titular")
  backup     @map("acompanante")
  valor_cero

  @@map("RolSesion")
}

enum TipoTarifa {
  fija
  variable
}

enum Moneda {
  USD
  ARS
}

enum ConceptoViatico {
  combustible
  alojamiento
  traslado
  almuerzo
  otros
}

model Cliente {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activo    Boolean  @default(true)

  // Datos del servicio contratado. Opcionales para que los clientes ya
  // cargados sigan siendo válidos; la fecha de finalización no se guarda:
  // se calcula siempre como fechaInicio + duracionMeses.
  duracionMeses Int?      @map("duracion_meses")
  producto      String?
  fechaInicio   DateTime? @map("fecha_inicio") @db.Date

  // Cuota mensual pactada. Obligatoria en los formularios (alta y edición),
  // pero nullable en la base: los clientes cargados antes de que existiera el
  // campo no tienen un valor real, y ponerles 0 por defecto sería afirmar que
  // no cobran. Queda vacío hasta que un admin lo complete.
  valorCuotaUsd Decimal? @map("valor_cuota_usd") @db.Decimal(10, 2)

  // Enlace al tablero operativo externo del proyecto (sección Proyectos).
  tableroUrl String? @map("tablero_url")

  // Momento en que se generó el Roadmap por defecto (Onboarding + un tablero
  // por trimestre). Es la marca que evita volver a sembrarlo: si el usuario
  // borra todas las listas, el proyecto queda vacío a propósito y nadie las
  // recrea por atrás.
  roadmapCreadoEn DateTime? @map("roadmap_creado_en")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registros       RegistroHoras[]
  asignaciones    ProyectoAsignado[]
  viaticos        Viatico[]
  facturaciones   Facturacion[]
  equipo          MiembroEquipo[]
  semaforoEventos SemaforoEvento[]
  etapaEventos    EtapaEvento[]
  tareas          TareaProyecto[]
  listasRoadmap   ListaRoadmap[]

  @@map("clientes")
}

// ── Sección Proyectos ──────────────────────────────────────────────────────
// Un "proyecto" es el cliente enriquecido: no existe una entidad aparte.
// El estado del semáforo y la etapa actual se registran como eventos: el
// vigente es el último, y el resto queda como historial con responsable.

enum SemaforoEstado {
  verde
  amarillo
  rojo
}

model SemaforoEvento {
  id          String         @id @default(cuid())
  clienteId   String         @map("cliente_id")
  cliente     Cliente        @relation(fields: [clienteId], references: [id])
  estado      SemaforoEstado
  creadoPorId String         @map("creado_por_id")
  creadoPor   Usuario        @relation(fields: [creadoPorId], references: [id])
  createdAt   DateTime       @default(now())

  @@index([clienteId, createdAt])
  @@map("semaforo_eventos")
}

model EtapaEvento {
  id          String   @id @default(cuid())
  clienteId   String   @map("cliente_id")
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  etapaId     String   @map("etapa_id")
  etapa       Etapa    @relation(fields: [etapaId], references: [id])
  creadoPorId String   @map("creado_por_id")
  creadoPor   Usuario  @relation(fields: [creadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([clienteId, createdAt])
  @@map("etapa_eventos")
}

enum EstadoTarea {
  pendiente
  en_curso
  hecha
}

// Tareas/hitos del Gantt. La sección se retiró de la app (se rediseñará más
// adelante) y el plan de trabajo vive ahora en ListaRoadmap/TareaRoadmap; el
// modelo se conserva para no borrar los cronogramas ya cargados.
model TareaProyecto {
  id          String      @id @default(cuid())
  clienteId   String      @map("cliente_id")
  cliente     Cliente     @relation(fields: [clienteId], references: [id])
  titulo      String
  fechaInicio DateTime    @map("fecha_inicio") @db.Date
  fechaFin    DateTime    @map("fecha_fin") @db.Date
  estado      EstadoTarea @default(pendiente)
  responsable String?
  orden       Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clienteId, fechaInicio])
  @@map("tareas_proyecto")
}

// ── Roadmap del proyecto ───────────────────────────────────────────────────
// El plan de trabajo: listas de tareas (Onboarding, un tablero por trimestre)
// con su presupuesto de horas. Cada proyecto arranca con una copia de las
// plantillas por defecto, pero desde ese momento sus listas son propias: no
// hay vínculo con la plantilla, así cada cliente puede evolucionar distinto.

enum EstadoTareaRoadmap {
  sin_iniciar
  en_curso
  no_ejecutada
  finalizada
}

model ListaRoadmap {
  id        String   @id @default(cuid())
  clienteId String   @map("cliente_id")
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  nombre    String
  orden     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tareas TareaRoadmap[]

  @@index([clienteId, orden])
  @@map("listas_roadmap")
}

model TareaRoadmap {
  id      String       @id @default(cuid())
  listaId String       @map("lista_id")
  lista   ListaRoadmap @relation(fields: [listaId], references: [id], onDelete: Cascade)
  nombre  String
  orden   Int          @default(0)

  // Las tareas son secuenciales: la duración en días hábiles es el dato que
  // manda y las fechas se derivan encadenando una tarea detrás de la otra.
  // Se guardan igual (y no solo la duración) para poder ordenar y filtrar por
  // fecha sin recalcular toda la cadena en cada consulta.
  fechaInicio  DateTime @map("fecha_inicio") @db.Date
  fechaFin     DateTime @map("fecha_fin") @db.Date
  duracionDias Int      @map("duracion_dias")

  // Presupuesto de entrega de la tarea. Cuando pasa a "finalizada", cuenta
  // como horas planificadas entregadas.
  horasEstimadas Decimal            @map("horas_estimadas") @db.Decimal(6, 2)
  estado         EstadoTareaRoadmap @default(sin_iniciar)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registros RegistroHoras[]

  @@index([listaId, orden])
  @@map("tareas_roadmap")
}

// Concepto de Time Tracking: en qué se consumieron las horas. Es un catálogo
// corto y curado que administra el admin, deliberadamente independiente del
// Roadmap: el Roadmap planifica (con fechas y horas estimadas) y el concepto
// clasifica gasto real. Por eso incluye cosas que no son tareas de un plan,
// como Traslado u Otros.
//
// Las horas siguen atadas al proyecto por RegistroHoras.clienteId, así que se
// pueden cruzar horas por proyecto y por concepto.
model Concepto {
  id     String  @id @default(cuid())
  nombre String  @unique
  // Orden de presentación: la secuencia del proceso (Primera Quincenal,
  // Primera Mensual, …) dice más que el alfabético.
  orden  Int     @default(0)
  // Baja lógica: retirar un concepto no puede desclasificar el historial.
  activo Boolean @default(true)

  createdAt DateTime @default(now())

  registros RegistroHoras[]

  @@map("conceptos")
}

// Integrantes del equipo del cliente (contactos del lado del cliente, no
// usuarios de la app): quién es quién en el proyecto y su cumpleaños.
model MiembroEquipo {
  id         String    @id @default(cuid())
  clienteId  String    @map("cliente_id")
  cliente    Cliente   @relation(fields: [clienteId], references: [id])
  nombre     String
  apellido   String
  rol        String
  cumpleanos DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clienteId])
  @@map("miembros_equipo")
}

// Facturación (lo que se le cobra al cliente) por proyecto y por mes. La
// carga el administrador; el margen del informe de rentabilidad es esta
// facturación menos el costo de mentores (suma de montoUsd de las horas).
model Facturacion {
  id        String   @id @default(cuid())
  clienteId String   @map("cliente_id")
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  anio      Int
  mes       Int // 1-12
  montoUsd  Decimal  @map("monto_usd") @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clienteId, anio, mes])
  @@index([anio, mes])
  @@map("facturaciones")
}

// Texto libre de "lecturas del mes" que redacta el administrador y que ve
// todo el que accede al informe de ese mes.
model NotaMes {
  id        String   @id @default(cuid())
  anio      Int
  mes       Int
  texto     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([anio, mes])
  @@map("notas_mes")
}

// Una sola entidad para todas las personas que usan la app. El "mentor" de
// las conversaciones con el cliente es, en el modelo de datos, un Usuario
// con rol "guest": no hace falta una tabla aparte para lo mismo.
model Usuario {
  id     String     @id @default(cuid())
  email  String     @unique
  nombre String
  rol    RolUsuario @default(guest)
  activo Boolean    @default(true)

  // Solo aplica a usuarios "guest". Definido por el administrador:
  // "fija" = un unico valor USD/hora sin importar modalidad ni ownership.
  // "variable" = un valor por cada combinacion de modalidad x ownership.
  // Nulo = todavia no configurado (no puede cargar horas facturables).
  tipoTarifa TipoTarifa? @map("tipo_tarifa")

  // Ruta de la foto de perfil en Supabase Storage (bucket público avatares).
  avatarPath String? @map("avatar_path")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tarifas            Tarifa[]
  registros          RegistroHoras[]    @relation("Mentor")
  registrosCreados   RegistroHoras[]    @relation("CreadoPor")
  proyectosAsignados ProyectoAsignado[]
  viaticos           Viatico[]
  vacaciones         Vacacion[]
  semaforoEventos    SemaforoEvento[]
  etapaEventos       EtapaEvento[]

  @@map("usuarios")
}

// Rol de un mentor dentro de un proyecto. Un proyecto tiene un único owner y
// hasta dos backups; el mismo usuario no puede ocupar los dos roles, cosa que
// ya garantiza la unicidad de (usuario, cliente): una sola fila por par.
enum RolProyecto {
  owner
  backup
}

// Asignación de un mentor a un proyecto. Cumple dos funciones: restringe en
// qué proyectos puede cargar horas un usuario "guest" (un usuario sin filas
// acá, o admin/reader, no tiene esa restricción) y declara su rol.
//
// `rol` es nullable porque las asignaciones anteriores a esta función no
// tienen un rol declarado: se hicieron solo para dar permiso de carga.
// Inventarles uno sería afirmar quién es responsable de cada proyecto sin
// ningún dato que lo respalde; quedan como "sin rol", conservan el permiso y
// el admin las completa desde Settings → Usuarios.
model ProyectoAsignado {
  id        String       @id @default(cuid())
  usuarioId String       @map("usuario_id")
  usuario   Usuario      @relation(fields: [usuarioId], references: [id])
  clienteId String       @map("cliente_id")
  cliente   Cliente      @relation(fields: [clienteId], references: [id])
  rol       RolProyecto?

  createdAt DateTime @default(now())

  // La unicidad de un único owner por proyecto se garantiza además con un
  // índice único parcial creado en la migración (Prisma no los expresa acá).
  @@unique([usuarioId, clienteId])
  @@index([clienteId, rol])
  @@map("proyectos_asignados")
}

// "Etapa" en la UI (antes "Tema/Temática"); la tabla en la base conserva su
// nombre original para no migrar datos.
model Etapa {
  id        String   @id @default(cuid())
  etiqueta  String
  grupo     String
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  registros RegistroHoras[]
  viaticos  Viatico[]
  eventos   EtapaEvento[]

  @@map("temas")
}

// Historial de tarifas por usuario (guest). Al cambiar una tarifa se cierra
// la vigente (vigenteHasta) y se crea una fila nueva; los registros ya
// cargados guardan su propio snapshot en RegistroHoras y no se ven
// afectados por este cambio.
model Tarifa {
  id           String    @id @default(cuid())
  usuarioId    String    @map("usuario_id")
  usuario      Usuario   @relation(fields: [usuarioId], references: [id])
  modalidad    Modalidad
  ownership    Ownership @map("rol")
  valorUsd     Decimal   @map("valor_usd") @db.Decimal(10, 2)
  vigenteDesde DateTime  @default(now()) @map("vigente_desde")
  vigenteHasta DateTime? @map("vigente_hasta")
  createdAt    DateTime  @default(now())

  @@unique([usuarioId, modalidad, ownership, vigenteDesde])
  @@index([usuarioId, modalidad, ownership, vigenteHasta])
  @@map("tarifas")
}

model RegistroHoras {
  id        String    @id @default(cuid())
  fecha     DateTime  @db.Date
  clienteId String    @map("cliente_id")
  cliente   Cliente   @relation(fields: [clienteId], references: [id])
  usuarioId String    @map("usuario_id")
  usuario   Usuario   @relation("Mentor", fields: [usuarioId], references: [id])

  // En qué se consumieron las horas. Es un concepto del catálogo, no una
  // tarea calendarizada: cargar horas no compite con el presupuesto de una
  // instancia puntual del Roadmap.
  conceptoId String?   @map("concepto_id")
  concepto   Concepto? @relation(fields: [conceptoId], references: [id])

  // Referencias de etapas anteriores del modelo, conservadas para no perder
  // el detalle histórico de con qué se cargó cada registro. Ya no se escriben:
  // tareaId apuntaba a una tarea concreta del Roadmap (migrado a categoriaId)
  // y etapaId al catálogo de Etapas, anterior al Roadmap.
  tareaId String?       @map("tarea_id")
  tarea   TareaRoadmap? @relation(fields: [tareaId], references: [id])
  etapaId String?       @map("tema_id")
  etapa   Etapa?        @relation(fields: [etapaId], references: [id])

  horas     Decimal   @db.Decimal(5, 2)
  modalidad Modalidad
  ownership Ownership @map("rol")
  nota      String?

  // Snapshot de la tarifa aplicada al momento de guardar (no se recalcula
  // retroactivamente si la tarifa del usuario cambia despues).
  tarifaUsdAplicada Decimal @map("tarifa_usd_aplicada") @db.Decimal(10, 2)
  montoUsd          Decimal @map("monto_usd") @db.Decimal(10, 2)

  creadoPorId String  @map("creado_por_id")
  creadoPor   Usuario @relation("CreadoPor", fields: [creadoPorId], references: [id])

  // Borrado logico: si tiene fecha, el registro esta en la papelera.
  eliminadoEn DateTime? @map("eliminado_en")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
  @@index([usuarioId, fecha])
  @@index([clienteId, fecha])
  @@index([tareaId])
  @@index([conceptoId])
  @@index([eliminadoEn])
  @@map("registros_horas")
}

model Viatico {
  id        String          @id @default(cuid())
  fecha     DateTime        @db.Date
  usuarioId String          @map("usuario_id")
  usuario   Usuario         @relation(fields: [usuarioId], references: [id])
  clienteId String          @map("cliente_id")
  cliente   Cliente         @relation(fields: [clienteId], references: [id])
  etapaId   String?         @map("etapa_id")
  etapa     Etapa?          @relation(fields: [etapaId], references: [id])
  moneda    Moneda
  monto     Decimal         @db.Decimal(12, 2)
  concepto  ConceptoViatico
  // Ruta del comprobante en Supabase Storage (bucket privado), opcional.
  archivoPath String?       @map("archivo_path")

  eliminadoEn DateTime? @map("eliminado_en")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId, fecha])
  @@index([clienteId, fecha])
  @@index([eliminadoEn])
  @@map("viaticos")
}

model Vacacion {
  id          String   @id @default(cuid())
  usuarioId   String   @map("usuario_id")
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  fechaInicio DateTime @map("fecha_inicio") @db.Date
  fechaFin    DateTime @map("fecha_fin") @db.Date
  dias        Int

  eliminadoEn DateTime? @map("eliminado_en")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId, fechaInicio])
  @@index([eliminadoEn])
  @@map("vacaciones")
}
